# weird little file that isn't intending to do any amine stuff, just replicating Behbahani and Schmid, Macromolecules 2025
# as such, running this file directly instead of with run.sh
# mpirun -np 12 --oversubscribe ../lammps/build/lmp -in in.polymers
print "Starting in.polymers"

# simulation format parameters
units lj    #  Lennard-Jones units, essentially unitless
dimension 3
boundary p p p
atom_style bond 

#----------------------------------
# C O N S T A N T S
#----------------------------------

variable patch_bond_r0 equal 0.45 # input from run.sh
variable patch_gauss_B_width equal 13.8504255125 # input from run.sh
variable patch_gauss_A_strength equal 50 # strength of Gaussian attraction between amine patches




# simulation constants
variable density equal 0.85
# variable N_beads equal 24000
# variable chain_length equal 30
variable N_chains equal round(${N_beads} / ${chain_length})  # total number of polymers, each of length 200
variable wall_size equal (${N_beads} / ${density})^(1/3) # box size to achieve desired density, scale by lj sigma of 1.3
print "Calculated box size is ${wall_size}"

# default form of molecule filename: "data/polymer_chainlength_{chain_length}_aminespacing_{amine_spacing}_backbone2patch_{backbone_to_patch}.molecule"
variable molecule_file string "data/polymer_chainlength_${chain_length}_aminespacing_0_backbone2patch_0.45.molecule"

# current run setup
variable output_traj equal 0
variable output_traj_file string "data/dumps/eq_chainlength_${chain_length}_gaussA_${patch_gauss_A_strength}_r0_${patch_bond_r0}_gaussB_${patch_gauss_B_width}.lammpstrj"
variable output_msd equal 0
variable output_msd_file string "logs/msd.dat"
variable output_amine equal 0
variable output_amine_file string logs/patch_n_${patch_gauss_A_strength}_${patch_bond_r0}.dat
variable output_press equal 0
variable output_press_file string "data/pressure/eqpress_chainlength_${chain_length}_gaussA_${patch_gauss_A_strength}_r0_${patch_bond_r0}_gaussB_${patch_gauss_B_width}.dat"
variable output_press_autocorr equal 0
variable output_press_autocorr_file string "data/autocorrelation/eqautocorr_chainlength_${chain_length}_gaussA_${patch_gauss_A_strength}_r0_${patch_bond_r0}_gaussB_${patch_gauss_B_width}.dat"

variable log_file string "logs/log.eq_chainlength_${chain_length}_gaussA_${patch_gauss_A_strength}_r0_${patch_bond_r0}_gaussB_${patch_gauss_B_width}"
variable restart_file string "data/restarts/restart.eq_chainlength_${chain_length}_gaussA_${patch_gauss_A_strength}_r0_${patch_bond_r0}_gaussB_${patch_gauss_B_width}"

variable random_seed equal 12345

# duration constants
variable soft_eq_steps equal 10000
variable interim_eq_steps equal 100000
variable eq_tol equal 0.01 # tolerance for pressure equilibration, in LJ units
variable thermo_eq_steps equal 100000
variable max_thermo_eq_iters equal 100


#-----------------------------------------------
# S I M U L A T I O N      S E T U P
#-----------------------------------------------
# log file
log ${log_file}

# create simulation box
region box block 0 ${wall_size} 0 ${wall_size} 0 ${wall_size}
create_box 2 box bond/types 2 extra/bond/per/atom 4 extra/special/per/atom 20

# polymer molecule definition
mass 1 1.0 # backbone mass
mass 2 1.0 # patch mass
molecule polymer ${molecule_file}

# intrachain bonds
bond_style fene/omp
bond_coeff 1 30.0 1.5 1.0 1.0 # k, r0, epsilon, sigma for FENE bonds between backbone beads
bond_coeff 2 5000 ${patch_bond_r0} 1.0 1.0  # stiff spring on patches
special_bonds fene # no interactions between adjacent atoms, but excluded volume for 1-3 and 1-4 interactions

# create atoms
print "N_beads = ${N_beads}  N_chains = ${N_chains} random_seed = ${random_seed}"
create_atoms 0 random ${N_chains} 12345 box mol polymer ${random_seed}

# group definitions
group monomer type 1
group amine type 2

# for visualization in OVITO
write_data data/data.replicated_particles

# neighbor list settings
neighbor 0.3 bin
neigh_modify every 1 delay 0 check yes
comm_modify cutoff 3.5

#-----------------------------------------------
# I N I T I A L      R E L A X A T I O N
#-----------------------------------------------

dump eq all custom 1000000 ${output_traj_file} id type mol x y z ix iy iz
restart 10000 ${restart_file} ${restart_file}

compute cc1 all chunk/atom molecule
compute myChunk all gyration/chunk cc1
fix gyration all ave/time 1000 1 1000 c_myChunk file data/r_gyration.out mode vector

fix limit all nve/limit 0.02
# run 200

# energy minimization to relax overlaps at beginning
print "30 Minimization start"
min_style cg             # fire more robust than cg
minimize 1.0e-6 1.0e-8 20000 200000

# soft potential
pair_style soft/omp 1.12246
pair_coeff * * 4.0 
# variable prefactor equal ramp(4, 800) # linearly ramp prefactor
# fix soft all adapt 1 pair soft a * * v_prefactor

fix 1 all langevin 1.0 1.0 0.5 ${random_seed} # Langevin thermostat, temp 1.0, damping parameter $(200.0*dt), random seed 12345
fix 2 all nve # NVE ensemble for production run, but use Langevin thermostat
fix damp all momentum 50 linear 1 1 1 # zero out momentum every 50 steps to prevent drifting
timestep 0.001
thermo 100

# run soft w/ 4.0
run 200000

# run soft w/ 20.0
pair_coeff * * 20.0
run 200000

# run soft w/ 100.0
pair_coeff * * 100.0
run 200000

# # run soft w/ 200.0
# pair_coeff * * 200.0
# run 200000

# # run soft w/ 500.0
# pair_coeff * * 500.0
# run 200000

# # run soft w/ 1000.0
# pair_coeff * * 1000.0
# run 200000

# variable soft_loops equal floor(${soft_eq_steps}/50)
# variable i loop ${soft_loops}
# label loop

# run 50
# velocity all set 0.0 0.0 0.0 # zero out velocities every 50 steps

# next i
# jump SELF loop

pair_style hybrid/overlay soft/omp 1.12246 lj/cut/omp 1.4592006628
pair_coeff * * soft/omp 0.0
pair_coeff 1 1 lj/cut/omp 0.05 1.0  # WCA between backbone beads
run 500000

unfix damp

pair_style lj/cut 1.12246
pair_coeff * * 1.0 1.0
run 500000

unfix 1
unfix 2
unfix limit

print "Soft potential relaxation complete"

#------------------------------------------------------------
# I N T E R M E D I A T E      R E L A X A T I O N
#------------------------------------------------------------
# # in between, start reducing soft and increasing WCA to prevent flying apart
# variable scaling equal ramp(1.0, 0.0)
# # variable other_scaling equal 1.0-v_scaling

# pair_style hybrid/scaled v_scaling soft 1.0 v_scaling lj/cut 1.4592006628 v_scaling gauss 2.0 # cutoff for both at 2.0
# pair_coeff * * soft 50.0
# pair_coeff 1 1 lj/cut 0.0 1.3  # no WCA between backbone beads, will ramp up
# pair_coeff 1 2 lj/cut 0.0 1.3  # WCA between backbone and amine patches
# pair_coeff 2 2 lj/cut 0.0 1.3 # no WCA between amine patches
# pair_modify shift yes # shift to zero at cutoff
# pair_coeff 2 2 gauss ${patch_gauss_A_strength} ${patch_gauss_B_width} 2.0 # Gaussian attraction between amine patches

# fix 1 all langevin 1.0 1.0 200.0 ${random_seed} # Langevin thermostat, temp 1.0, damping parameter $(200.0*dt), random seed 12345
# fix 2 all nve # NVE ensemble for production run, but use Langevin thermostat for equilibration to speed up convergence
# timestep 0.005
# thermo 100
# run ${interim_eq_steps}

# unfix 1
# unfix 2
# print "Interim relaxation complete"
# TODO uncomment below here to return thermal eq 
#------------------------------------------------------------
# T H E R M A L      E Q U I L I B R A T I O N
#------------------------------------------------------------
# interatomic potentials (non-bonded)
pair_style hybrid/overlay lj/cut/omp 1.12246205 gauss/omp 2.0 # cutoff for both at 2.0
pair_coeff 1 1 lj/cut/omp 1.0 1.0  # WCA between backbone beads
pair_coeff 1 2 lj/cut/omp 0.0 1.0  # WCA between backbone and amine patches
pair_coeff 2 2 lj/cut/omp 0.0 1.0 # no WCA between amine patches
pair_modify shift yes # shift to zero at cutoff
pair_coeff 2 2 gauss/omp ${patch_gauss_A_strength} ${patch_gauss_B_width} 2.0 # Gaussian attraction between amine patches

# initial velocities for equilibration
timestep 0.005
# velocity all create 1.0 1 # initial temperature 1.0, random seed 1

fix 1 all langevin/omp 1.0 1.0 200.0 ${random_seed} # Langevin thermostat, temp 1.0, damping parameter $(200.0*dt), random seed 12345
fix 2 all nve/omp # NVE ensemble for production run, but use Langevin thermostat for equilibration to speed up convergence

# initial setup
thermo 100
compute press all pressure thermo_temp # comparing pressure over time to see when eq'ed

# in case we can't equilibrate, don't want inifinite loop
variable iteration equal 0

# first run to get initial value, subsequent runs don't need this since we can just use the previous value
fix prev_ave_fix all ave/time 1 ${thermo_eq_steps} ${thermo_eq_steps} c_press
# run ${thermo_eq_steps} # switching to set runtime just to check long term behaviour
run 5000000
variable prev_ave equal f_prev_ave_fix
variable prev_snapshot equal ${prev_ave}
unfix prev_ave_fix

# ########### LOOP STARTS HERE ############
# label eq

# # check iter. count end conditions
# if "${iteration} > ${max_thermo_eq_iters}" then &
#     "print 'Equilibration did not converge after ${max_thermo_eq_iters} iterations, exiting with error'" &
#     "quit 1"

# fix current_ave_fix all ave/time 1 ${thermo_eq_steps} ${thermo_eq_steps} c_press
# run ${thermo_eq_steps}
# variable current_ave equal f_current_ave_fix
# variable current_snapshot equal ${current_ave}
# variable difference equal abs(${current_snapshot} - ${prev_snapshot})
# print 'from ${prev_snapshot} to ${current_snapshot}'
# print 'difference is ${difference}, the tolerance is ${eq_tol}'

# # check EQ end conditions
# variable iteration equal ${iteration} + 1
# if "${difference} > ${eq_tol}" then &
#     "variable prev_snapshot equal ${current_snapshot}" &
#     "jump SELF eq" &
# else &
#     "print 'thermal equilibration complete'" &

########### LOOP ENDS HERE ############
# unfix current_ave_fix
undump eq
unfix gyration
reset_timestep 0
print "Equilibration done"
