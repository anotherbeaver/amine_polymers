print "Starting in.polymers"

suffix omp
package omp 2

#----------------------------------
# C O N S T A N T S
#----------------------------------

variable patch_bond_r0 equal 0.35
variable patch_gauss_B_width equal 10
# variable patch_gauss_A_strength equal 50 # strength of Gaussian attraction between sticky patches # set by .sh script

# simulation constants
variable density equal 0.85
# variable N_beads equal 24000 # set by .sh script
# variable chain_length equal 30 # set by .sh script
variable N_chains equal round(${N_beads} / ${chain_length})  # total number of polymers
variable wall_size equal (${N_beads} / ${density})^(1/3)  # box size to achieve desired density
print "Calculated box size is ${wall_size}"

# default form of molecule filename: "data/polymer_chainlength_{chain_length}_patchspacing_{patch_spacing}_backbone2patch_{backbone_to_patch}.molecule"
variable molecule_file string "data/polymer_chainlength_${chain_length}_patchspacing_${patch_spacing}_backbone2patch_${patch_bond_r0}.molecule"

# current run setup
variable output_traj equal 0
variable output_traj_file string "data/dumps/prod_chainlength_${chain_length}_patchspacing_${patch_spacing}_N_beads_${N_beads}_gaussA_${patch_gauss_A_strength}_r0_${patch_bond_r0}_gaussB_${patch_gauss_B_width}_seed_${random_seed}.bin"
variable output_traj_patch equal 0
variable output_traj_patch_file string "data/dumps/prodpatch_chainlength_${chain_length}_patchspacing_${patch_spacing}_N_beads_${N_beads}_gaussA_${patch_gauss_A_strength}_r0_${patch_bond_r0}_gaussB_${patch_gauss_B_width}_seed_${random_seed}.bin"
variable output_msd equal 0
variable output_msd_file string "logs/msd.dat"
variable output_patch equal 1
variable output_patch_file string "data/patches/prodpatch_chainlength_${chain_length}_patchspacing_${patch_spacing}_N_beads_${N_beads}_gaussA_${patch_gauss_A_strength}_r0_${patch_bond_r0}_gaussB_${patch_gauss_B_width}_seed_${random_seed}.bin"
variable output_press equal 0
variable output_press_file string "data/pressures/prodpress_chainlength_${chain_length}_patchspacing_${patch_spacing}_N_beads_${N_beads}_gaussA_${patch_gauss_A_strength}_r0_${patch_bond_r0}_gaussB_${patch_gauss_B_width}_seed_${random_seed}.dat"
variable output_press_autocorr equal 0
variable output_press_autocorr_file string "data/autocorrelation/prodautocorr_chainlength_${chain_length}_patchspacing_${patch_spacing}_N_beads_${N_beads}_gaussA_${patch_gauss_A_strength}_r0_${patch_bond_r0}_gaussB_${patch_gauss_B_width}_seed_${random_seed}.dat"

variable log_file string "logs/log.prod_chainlength_${chain_length}_patchspacing_${patch_spacing}_N_beads_${N_beads}_gaussA_${patch_gauss_A_strength}_r0_${patch_bond_r0}_gaussB_${patch_gauss_B_width}_seed_${random_seed}"
variable restart_file string "data/restarts/restart.eq_chainlength_${chain_length}_patchspacing_${patch_spacing}_N_beads_${N_beads}_gaussA_${patch_gauss_A_strength}_r0_${patch_bond_r0}_gaussB_${patch_gauss_B_width}_seed_${random_seed}"

# variable random_seed equal 12345 # input from run.sh


#-----------------------------------------------
# S I M U L A T I O N      S E T U P
#-----------------------------------------------
# log file
log ${log_file}

# create atoms
print "N_beads = ${N_beads}  N_chains = ${N_chains}  gauss_A = ${patch_gauss_A_strength}  gauss_B = ${patch_gauss_B_width}  random_seed = ${random_seed}"
# create_atoms 0 random ${N_chains} 12345 box mol polymer ${random_seed}
read_restart ${restart_file} # read in the final configuration from the equilibration run

reset_timestep 0

# group definitions
group monomer type 1
group patch type 2

bond_style hybrid fene/omp harmonic/omp
bond_coeff 1 fene/omp 30.0 1.5 1.0 1.0 # k, r0, epsilon, sigma for FENE bonds between backbone beads
bond_coeff 2 harmonic/omp 30000 0.25  # stiff spring on patches
special_bonds fene # no interactions between adjacent atoms, but excluded volume for 1-3 and 1-4 interactions

# neighbor list settings
neighbor 0.5 bin #TODO return this to 0.3 if things break
neigh_modify every 1 delay 0 check yes
comm_modify cutoff 3.5

# interatomic potentials (non-bonded)
pair_style hybrid/overlay lj/cut/omp 1.12246205 gauss/omp 2.0 # cutoff for both at 2.0
pair_coeff 1 1 lj/cut/omp 1.0 1.0  # WCA between backbone beads
pair_coeff 1 2 lj/cut/omp 0.0 1.0  # WCA between backbone and patches
pair_coeff 2 2 lj/cut/omp 0.0 1.0 # no WCA between patches
pair_modify shift yes # shift to zero at cutoff
pair_coeff 2 2 gauss/omp ${patch_gauss_A_strength} ${patch_gauss_B_width} 2.0 # Gaussian attraction between sticky patches

fix langevin_int all langevin 1.0 1.0 200.0 ${random_seed} # Langevin thermostat, temp 1.0, damping parameter $(200.0*dt), random seed 12345
fix nve_int all nve/omp # switch to NVE ensemble

# save mean squared displacement data (optional)
if "${output_msd} == 1" then &
    "print 'Saving MSD data to ${output_msd_file}'" &
    "compute MSD all msd" &
    "fix msd_avg all ave/time 10 1 10 c_MSD[4] file ${output_msd_file} mode scalar"

# # save patch positions for bond analysis (optional)
# if "${output_patch} == 1" then &
#     "print 'Saving patch positions to ${output_patch_file}'" &
#     "compute patch_coord patch coord/atom cutoff 0.5" &
#     "compute patch_cluster patch cluster/atom 0.5" &
#     "dump patch_dump patch custom 100 ${output_patch_file} id mol x y z c_patch_coord c_patch_cluster"

# save trajectory of all particles (optional)
if "${output_traj} == 1" then &
    "print 'Saving trajectory to ${output_traj_file}'" &
    "dump prod all custom 100 ${output_traj_file} id type mol x y z ix iy iz"



# save p_xy data for modulus calculation
if "${output_press} == 1" then &
    "print 'Saving pressure data to ${output_press_file}'" &
    "fix 2 all ave/time 1 1 10 c_thermo_press[0] c_thermo_press[1] c_thermo_press[2] c_thermo_press[3] c_thermo_press[4] c_thermo_press[5] c_thermo_press[6] file ${output_press_file}"

variable px_y equal c_thermo_press[1] - c_thermo_press[2]
variable px_z equal c_thermo_press[1] - c_thermo_press[3]
variable py_z equal c_thermo_press[2] - c_thermo_press[3]

if "${output_press_autocorr} == 1" then &
    "print 'Saving pressure autocorrelation data to ${output_press_autocorr_file}' " &
    "fix long_corr monomer ave/correlate/long 1 10000 v_px_y v_px_z v_py_z c_thermo_press[4] c_thermo_press[5] c_thermo_press[6] type auto file ${output_press_autocorr_file} overwrite title1 title2 ncorr 40 nlen 16 ncount 2" &
        # "v_px_y v_px_z v_py_z c_thermo_press[4] c_thermo_press[5] c_thermo_press[6]" &
        # "type auto & " &
        # "file ${output_press_autocorr_file} &" &
        # "overwrite &" &
        # "title1 "# v_px_y v_px_z v_py_z c_thermo_press[4] c_thermo_press[5] c_thermo_press[6]" & " &
        # "title2 "# total number of atoms: ${natoms}" &" &
        # "ncorr 70 &" &
        # "nlen 16 &" &
        # "ncount 2" &

#-----------------------------------------------
# P R O D U C T I O N     R U N 
#-----------------------------------------------

# experiment run 
# compute temp_com all temp/com
# # centre-of-mass msd calculation
# compute mol_chunks all chunk/atom molecule
# compute mol_msd all msd/chunk mol_chunks
# fix msd_out all ave/time 1000 1 1000 c_mol_msd file data/msd/prodmsd_chainlength_${chain_length}_N_beads_${N_beads}_gaussA_${patch_gauss_A_strength}_r0_${patch_bond_r0}_gaussB_${patch_gauss_B_width}_seed_${random_seed}.dat mode vector

timestep 0.002
thermo_style custom step temp epair emol etotal press pxy
thermo 100
# run for 10 million, then get bond lifetime data, then run for rest of production run
# run 10000000
# -------------------------------
# B O N D     L I F E T I M E
# -------------------------------
# save trajectory of patches (optional)
if "${output_traj_patch} == 1" then &
    "print 'Saving trajectory to ${output_traj_patch_file}'" &
    "dump patch_prod patch custom 10 ${output_traj_patch_file} id type mol x y z ix iy iz"

if "${output_patch} == 1" then &
    "print 'Saving patch positions to ${output_patch_file}'" &
    "compute patch_coord patch coord/atom cutoff 0.6" &
    "compute patch_cluster patch cluster/atom 0.6" &
    "dump patch_dump patch custom 10 ${output_patch_file} id mol x y z c_patch_coord c_patch_cluster"

if "${output_patch} == 1 || ${output_traj_patch} == 1" then &
    "print 'Running for bond lifetime data collection'" &
    "run 500000"

if "${output_traj_patch} == 1" then &
    "undump patch_prod"

if "${output_patch} == 1" then &
    "undump patch_dump"

# -------------------------------
# B A C K     T O     P R O D
# -------------------------------
# run 490000000

variable density equal ${N_beads} / (${wall_size} * ${wall_size} * ${wall_size})
print "Final density is ${density}"

print "Ending in.polymers_prod"
