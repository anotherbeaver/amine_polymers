# mpirun -np 6 ../lammps/build/lmp -in in.amine_polymers

print "Starting in.amine_polymers"

# simulation parameters
units lj    #  Lennard-Jones units, essentially unitless
dimension 3
boundary p p p
atom_style bond 
log logs/log.amine_polymers 

variable N equal 1000
# variable BOX_SIZE equal 40
variable BOX_SIZE equal 40  


# initial configuration
# read_data data/data.particles
# replicate 5 10 10

# trying with molecule file instead
region box block 0 ${BOX_SIZE} 0 ${BOX_SIZE} 0 ${BOX_SIZE}
create_box 2 box bond/types 2 extra/bond/per/atom 4 extra/special/per/atom 20

mass 1 1.0 # backbone + dummy mass
mass 2 1.0 # patch mass

molecule polymer data/polymer.molecule

# bond potentials (harmonic)
bond_style harmonic
bond_coeff 1 50.0 1.0 # k, r0 # backbone stiffness
# k is derived from Raffaeilli and Ellenbroek, Soft Matter 2021
# "...polymer backbones have a stiffness of 50e/b^2..."
bond_coeff 2 100 0.9 # stiff spring on patches

# interatomic potentials (non-bonded)
pair_style hybrid/overlay lj/cut 1.4592006628 gauss 2.0 # cutoff for both at 2.0
pair_coeff 1 1 lj/cut 1.0 1.3  # WCA between backbone beads
pair_coeff 1 2 lj/cut 1.0 1.3  # WCA between backbone and amine patches
pair_coeff 2 2 lj/cut 0.0 1.3 # no WCA between amine patches
pair_modify shift yes # shift to zero at cutoff
pair_coeff 2 2 gauss 50.0 13.8504255125 2.0 # Gaussian attraction between amine patches

create_atoms 0 random $N 12345 box mol polymer 12345

# group definitions
group monomer type 1
group amine type 2

write_data data/data.replicated_particles # for visualization in OVITO

# save potential as a file
pair_write 1 1 1000 r 0.01 2.0 data/pair_coeff_1_1.txt BACKBONE_BACKBONE
pair_write 1 2 1000 r 0.01 2.0 data/pair_coeff_1_2.txt BACKBONE_PATCH
pair_write 2 2 1000 r 0.01 2.0 data/pair_coeff_2_2.txt PATCH_PATCH


# neighbor list (not too sure why we need this)
neighbor 0.3 bin
neigh_modify every 1 delay 0 check yes

# Energy minimization to relax overlaps (is this necessary?)
min_style cg             # conjugate gradient (good default)
minimize 1.0e-6 1.0e-8 10000 100000

# track transient bonds
# compute amine_pairs amine pair/local id1 id2 dist 
# dump 1 amine local 10 data/amine_bonds.dat c_amine_pairs[*]
# group all_atoms type 1 2
displace_atoms all move 0.0 0.0 0.0 units box
dump aminepos amine custom 10 data/amine_positions.lammpstrj id type x y z


# initial velocities for equilibration
timestep 0.005 # could be 0.001, Raffaeilli and Ellenbroek, Soft Matter 2021
velocity all create 0.6 1 # initial temperature 0.6, random seed 1
fix 1 all nvt temp 0.6 0.6 $(200.0*dt) # NVT ensemble, temp 0.6, damping parameter 1.0
print "damping coefficient is $(200.0*dt)"
# fix 1 all nve # integrate with NVE ensemble

reset_timestep 0
dump 2 all atom 10 data/dump.equil.lammpstrj
thermo 100
run 10000

