# mpirun -np 6 ../lammps/build/lmp -in in.amine_polymers

print "Starting in.amine_polymers"

# simulation parameters
units lj    #  Lennard-Jones units, essentially unitless
dimension 3
boundary p p p
atom_style bond 
# log logs/log.amine_polymers # TODO: change this back

variable N equal 500
# variable N equal 20
variable BOX_SIZE equal 40

# variable patch_bond_r0 equal 0.9  # A type
variable patch_bond_r0 equal 0.45  # C type

# variable patch_gauss_B_width equal 13.8504255125 # A type
variable patch_gauss_B_width equal 2.6315789474 # C type

variable patch_gauss_A_strength equal 0 # strength of Gaussian attraction between amine patches

# variable hbond_energy_scale equal 100.0 # strength of hydrogen bond interaction between amine patches
# TODO: currently this is being set by run.sh, turn it back when done testing

# initial configuration
# read_data data/data.particles
# replicate 5 10 10

# trying with molecule file instead
region box block 0 ${BOX_SIZE} 0 ${BOX_SIZE} 0 ${BOX_SIZE}
create_box 4 box bond/types 4 extra/bond/per/atom 5 extra/special/per/atom 20

molecule polymer data/polymer.molecule


create_atoms 0 random $N 12345 box mol polymer 12345


# group definitions
group monomer type 1
group donor type 2
group h_dummy type 3
group acceptor type 4

mass 1 1.0 # backbone mass
mass 2 1.0 # donor mass
mass 3 1.0 # h_dummy mass
mass 4 1.0 # acceptor mass

# write_data data/data.replicated_particles # for visualization in OVITO 
# TODO: change this back



# bond potentials (harmonic)
bond_style harmonic
bond_coeff 1 50.0 1.0 # k, r0 # backbone stiffness
bond_coeff 2 50.0 1.0 # k, r0 # backbone stiffness
bond_coeff 3 50.0 0.45 # k, r0 # donor–h_dummy bond
bond_coeff 4 50.0 0.45 # k, r0 # backbone
# k is derived from Raffaeilli and Ellenbroek, Soft Matter 2021
# "...polymer backbones have a stiffness of 50e/b^2..."
# bond_coeff 2 100 ${patch_bond_r0} # stiff spring on patches
# NOTE: THIS IS WHERE A/C DIFFERENCE IS (0.9 vs 0.45)

# nonbonded potentials
pair_style hybrid/overlay lj/cut 1.4592006628 hbond/dreiding/lj 4 0.8 2.0 180.0

# WCA repulsions
pair_coeff 1 1 lj/cut 1.0 1.3    # monomer-monomer
pair_coeff 1 2 lj/cut 1.0 1.3    # monomer-donor
pair_coeff 1 3 lj/cut 0.0 1.3    # monomer-h_dummy (off)
pair_coeff 1 4 lj/cut 1.0 1.3    # monomer-acceptor


pair_coeff 2 2 lj/cut 1.0 1.3    # donor-donor
pair_coeff 2 3 lj/cut 1.0 1.3    # donor-h_dummy
pair_coeff 2 4 lj/cut 0.0 1.3    # donor-acceptor

pair_coeff 3 3 lj/cut 1.0 1.3    # h_dummy-h_dummy
pair_coeff 3 4 lj/cut 1.0 1.3    # h_dummy-acceptor

pair_coeff 4 4 lj/cut 1.0 1.3    # acceptor-acceptor

pair_modify shift yes

# hydrogen bonding potential (DREIDING)
pair_coeff 2 4 hbond/dreiding/lj 3 i ${hbond_energy_scale} 0.8 4 0.8 2.0 90.0




# neighbor list (not too sure why we need this)
neighbor 2.5 bin
neigh_modify every 1 delay 0 check yes

# Energy minimization to relax overlaps (is this necessary?)
min_style cg             # conjugate gradient (good default)
minimize 1.0e-6 1.0e-8 10000 100000
reset_timestep 0

# track transient bonds
# compute amine_pairs amine pair/local id1 id2 dist 
# dump 1 amine local 10 data/amine_bonds.dat c_amine_pairs[*]
# group all_atoms type 1 2
# displace_atoms all move 0.0 0.0 0.0 units box
# dump aminepos amine custom 10 data/amine_positions.lammpstrj id type x y z


# write LJ potentials
# pair_write 2 4 500 r 0.01 3.0 data/pair_hbond.dat HBND

# initial velocities for equilibration
timestep 0.005 # could be 0.001, Raffaeilli and Ellenbroek, Soft Matter 2021
velocity all create 1.0 1 # initial temperature 1.0, random seed 1
fix 1 all nvt temp 1.0 1.0 $(100.0*dt) # NVT ensemble, temp 1.0, damping parameter $(100.0*dt) ONLY backbone beads
print "damping coefficient is $(100.0*dt)"
# fix 1 all nve # integrate with NVE ensemble


# mean squared displacement for diffusion calculations
compute MSD all msd
fix msd_avg all ave/time 10 1 10 c_MSD[4] file ${output_file} mode scalar

thermo 100
run 150000  # TODO: change this back

# equilibration done, now run NVT ensemble with thermostat
# unfix 1
# unfix msd_avg
# undump 2
# uncompute MSD
# undump aminepos
# reset_timestep 0


# compute MSD all msd
# fix msd_avg all ave/time 10 1 10 c_MSD[4] file logs/msd_vector_nvt.dat mode scalar

group reversible type 2 4
# displace_atoms all move 0.0 0.0 0.0 units box\
# dump reversible donor custom 10 data/amine_positions.lammpstrj id type x y z # TODO: change this back
compute hb all pair hbond/dreiding/lj
variable n_hbond equal c_hb[1] #number hbonds
variable E_hbond equal c_hb[2] #hbond energy
# thermo_style custom step temp epair press v_n_hbond v_E_hbond # TODO: change this back
# fix 2 all nvt temp 1.0 1.0 $(200.0*dt) # NVT ensemble, temp 1.0, damping parameter $(200.0*dt)
# dump 3 all atom 10 data/dump.nvt.lammpstrj
# dump 2 all atom 10 data/dump.equil.lammpstrj
timestep 0.005
thermo 100
run 300000




print "Ending in.amine_polymers"
