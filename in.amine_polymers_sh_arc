# mpirun -np 12 --oversubscribe ../lammps/build/lmp -in in.amine_polymers_sh
print "Starting in.amine_polymers"

# simulation format parameters
units lj    #  Lennard-Jones units, essentially unitless
dimension 3
boundary p p p
atom_style bond 
log logs/log.amine_polymers


# variable patch_bond_r0 equal 0.45 # input from run.sh
# variable patch_gauss_B_width equal 13.8504255125 # input from run.sh
# variable patch_gauss_A_strength equal 50 # strength of Gaussian attraction between amine patches
# variable output_amine_file string logs/patch_n_${patch_gauss_A_strength}_${patch_bond_r0}.dat


# variable output_traj equal 0
# variable output_traj_file equal "logs/dump.lammpstrj"
# variable output_msd equal 0
# variable output_msd_file equal "logs/msd.dat"
# variable output_amine equal 1
# variable output_amine_file equal "logs/amine_positions.dat"
# variable random_seed equal 12345



# simulation constants
variable density equal 0.45
variable N_beads equal 50000
variable N_chains equal round(${N_beads} / 30)  # total number of polymers, each of length 30
variable wall_size equal (${N_beads} / ${density})^(1/3)  # box size to achieve desired density
print "Calculated box size is ${wall_size}"

# create simulation box
region box block 0 ${wall_size} 0 ${wall_size} 0 ${wall_size}

create_box 2 box bond/types 2 extra/bond/per/atom 4 extra/special/per/atom 20

# polymer molecule definition
mass 1 1.0 # backbone + dummy mass
mass 2 1.0 # patch mass
molecule polymer_short data/polymer.molecule    # TODO: currently short is wrong, only for testing
molecule polymer_long data/polymer_long.molecule

# bond potentials (harmonic)
# bond_style fene
# special_bonds fene 
# bond_coeff 1 50 1.8 1.0 1.3 # FENE for backbone
# bond_coeff 2 5000 0.95 0.2 0.45 # stiff spring on patches

bond_style harmonic
bond_coeff 1 50.0 1.0 # k, r0 # backbone stiffness
# k is derived from Raffaeilli and Ellenbroek, Soft Matter 2021
# "...polymer backbones have a stiffness of 50e/b^2..."
bond_coeff 2 5000 ${patch_bond_r0} # stiff spring on patches
special_bonds lj 0.0 1.0 1.0 # no interactions between adjacent atoms, but excluded volume for 1-3 and 1-4 interactions


# pair_style soft 1.0
# pair_coeff * * 20.0
# interatomic potentials (non-bonded)
pair_style hybrid/overlay lj/cut 1.4592006628 gauss 2.0 # cutoff for both at 2.0
pair_coeff 1 1 lj/cut 1.0 1.3  # WCA between backbone beads
pair_coeff 1 2 lj/cut 0.0 1.3  # WCA between backbone and amine patches
pair_coeff 2 2 lj/cut 0.0 1.3 # no WCA between amine patches
pair_modify shift yes # shift to zero at cutoff
pair_coeff 2 2 gauss ${patch_gauss_A_strength} ${patch_gauss_B_width} 2.0 # Gaussian attraction between amine patches

# create atoms
print "N = ${N}  N_beads = ${N_beads}  N_chains = ${N_chains} random_seed = ${random_seed}"
create_atoms 0 random ${N_chains} 12345 box mol polymer_short ${random_seed}

# group definitions
group monomer type 1
group amine type 2

# for visualization in OVITO
write_data data/data.replicated_particles

# neighbor list settings
neighbor 0.5 bin
neigh_modify every 1 delay 0 check yes
comm_modify cutoff 3.5

fix limit all nve/limit 0.05
run 200
unfix limit

# energy minimization to relax overlaps at beginning
print "30 Minimization start"
min_style cg             # fire more robust than cg
minimize 1.0e-6 1.0e-8 20000 200000

# interatomic potentials (non-bonded)
pair_style hybrid/overlay lj/cut 1.4592006628 gauss 2.0 # cutoff for both at 2.0
pair_coeff 1 1 lj/cut 1.0 1.3  # WCA between backbone beads
pair_coeff 1 2 lj/cut 0.0 1.3  # WCA between backbone and amine patches
pair_coeff 2 2 lj/cut 0.0 1.3 # no WCA between amine patches
pair_modify shift yes # shift to zero at cutoff
pair_coeff 2 2 gauss ${patch_gauss_A_strength} ${patch_gauss_B_width} 2.0 # Gaussian attraction between amine patches

# initial velocities for equilibration
timestep 0.005 # could be 0.001, Raffaeilli and Ellenbroek, Soft Matter 2021
velocity all create 1.0 1 # initial temperature 1.0, random seed 1
fix 1 all nvt temp 1.0 1.0 $(200.0*dt) # NVT ensemble, temp 1.0, damping parameter $(200.0*dt)
print "damping coefficient is $(200.0*dt)"

# equilibration run
thermo 100
dump eq all atom 100 data/equilibration.lammpstrj
run 5000000
undump eq
reset_timestep 0
print "Equilibration done"

unfix 1
fix 1 all nve # switch to NVE ensemble

# save mean squared displacement data (optional)
if "${output_msd} == 1" then &
    "print 'Saving MSD data to ${output_msd_file}'" &
    "compute MSD all msd" &
    "fix msd_avg all ave/time 10 1 10 c_MSD[4] file ${output_msd_file} mode scalar"

# save amine positions for bond analysis (optional)
if "${output_amine} == 1" then &
    "print 'Saving amine positions to ${output_amine_file}'" &
    "dump aminepos amine custom 100000 ${output_amine_file} id type x y z"

# save trajectory of all particles (optional)
if "${output_traj} == 1" then &
    "print 'Saving trajectory to ${output_traj_file}'" &
    "dump traj all atom 10 ${output_traj_file}"

# save p_xy data for modulus calculation
if "${output_press} == 1" then &
    "print 'Saving pressure data to ${output_press_file}'" &
    "fix 2 all ave/time 1 1 10 c_thermo_press[0] c_thermo_press[1] c_thermo_press[2] c_thermo_press[3] c_thermo_press[4] c_thermo_press[5] c_thermo_press[6] file ${output_press_file}"

variable px_y equal c_thermo_press[1] - c_thermo_press[2]
variable px_z equal c_thermo_press[1] - c_thermo_press[3]
variable py_z equal c_thermo_press[2] - c_thermo_press[3]

# compute average end to end length of a chain (atom ID 1 and 30, so only works for chain length 30)
variable dxx equal x[1] - x[30]
variable dyy equal y[1] - y[30]
variable dzz equal z[1] - z[30]
variable re2 equal v_dxx*v_dxx + v_dyy*v_dyy + v_dzz*v_dzz
variable re equal sqrt(v_re2)
fix endtoend all ave/time 100 100 10000 v_re file logs/endtoend_short.dat

# compute all_atoms all count/type atom
variable natoms equal atoms
print "Total number of atoms is ${natoms}"

fix long_corr all ave/correlate/long 1 100000 &
          v_px_y v_px_z v_py_z c_thermo_press[4] c_thermo_press[5] c_thermo_press[6] &
          type auto & 
          file ${output_press_file} &
          overwrite &
          title1 "# v_px_y v_px_z v_py_z c_thermo_press[4] c_thermo_press[5] c_thermo_press[6]" & 
          title2 "# total number of atoms: ${natoms}" &
          ncorr 70 &
          nlen 16 &
          ncount 2

# experiment run 
timestep 0.005
thermo_style custom step temp epair emol etotal press pxy
thermo 100
if "${random_seed} == 100" then &
    "run 120000" & 
else &
    "run 120000000"


variable density equal ${natoms} / (30 * 30 * 30)
print "Final density is ${density}"

print "Ending in.amine_polymers_sh_short"
