# Original location: <PROJECT_ROOT>/in.no_dummy
# mpirun -np 6 ../lammps/build/lmp -in in.amine_polymers

print "Starting in.amine_polymers"

# simulation parameters
units lj    #  Lennard-Jones units, essentially unitless
dimension 3
boundary p p p
atom_style bond 
log logs/log.amine_polymers 





# initial configuration
# read_data data/data.particles
# replicate 5 10 10

# trying with molecule file instead
region box block 0 40 0 40 0 40
create_box 2 box bond/types 2 extra/bond/per/atom 4 extra/special/per/atom 20

mass 1 1.0 # backbone + dummy mass
mass 2 1.0 # patch mass

molecule polymer data/polymer.molecule

create_atoms 0 single 20.0 20.0 20.0 mol polymer 12345

# group definitions
group monomer type 1
group amine type 2

write_data data/data.no_dummy # for visualization in OVITO