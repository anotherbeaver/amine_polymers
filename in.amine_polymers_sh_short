# experiment run
timestep 0.001 
thermo_style custom step temp epair emol etotal press pxy
thermo 100
run 120000000

variable density equal ${c_all_atoms} / (15.22*15.22*15.22)
print "Final density is ${density}"

print "Ending in.amine_polymers"
