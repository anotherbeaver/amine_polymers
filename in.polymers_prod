# weird little file that isn't intending to do any amine stuff, just replicating Behbahani and Schmid, Macromolecules 2025
# as such, running this file directly instead of with run.sh
# mpirun -np 12 --oversubscribe ../lammps/build/lmp -in in.polymers
print "Starting in.polymers"

#----------------------------------
# C O N S T A N T S
#----------------------------------

# simulation constants
variable density equal 0.85
variable N_beads equal 24000
variable chain_length equal 30
variable N_chains equal round(${N_beads} / ${chain_length})  # total number of polymers, each of length 200
variable wall_size equal (${N_beads} / ${density})^(1/3)  # box size to achieve desired density
print "Calculated box size is ${wall_size}"


variable patch_bond_r0 equal 0.45 # input from run.sh
variable patch_gauss_B_width equal 13.8504255125 # input from run.sh
variable patch_gauss_A_strength equal 50 # strength of Gaussian attraction between amine patches

variable molecule_file string "data/polymer_chainlength_30_aminespacing_0_backbone2patch_0.45.molecule"

variable output_traj equal 0
variable output_traj_file string "data/dumps/prod_chainlength_${chain_length}_gaussA_${patch_gauss_A_strength}_r0_${patch_bond_r0}_gaussB_${patch_gauss_B_width}.lammpstrj"
variable output_msd equal 0
variable output_msd_file string "logs/msd.dat"
variable output_amine equal 0
variable output_amine_file string logs/patch_n_${patch_gauss_A_strength}_${patch_bond_r0}.dat
# variable output_amine_file equal "logs/amine_positions.dat"
variable output_press equal 1
variable output_press_file string "data/pressure/prodpress_chainlength_${chain_length}_gaussA_${patch_gauss_A_strength}_r0_${patch_bond_r0}_gaussB_${patch_gauss_B_width}.dat"
variable output_press_autocorr equal 1
variable output_press_autocorr_file string "data/autocorrelation/prodautocorr_chainlength_${chain_length}_gaussA_${patch_gauss_A_strength}_r0_${patch_bond_r0}_gaussB_${patch_gauss_B_width}.dat"

variable log_file string "logs/log.prod_chainlength_${chain_length}_gaussA_${patch_gauss_A_strength}_r0_${patch_bond_r0}_gaussB_${patch_gauss_B_width}"
variable restart_file string "data/restarts/restart.eq_chainlength_${chain_length}_gaussA_${patch_gauss_A_strength}_r0_${patch_bond_r0}_gaussB_${patch_gauss_B_width}_langevin"

variable use_existing_eq equal 0


variable random_seed equal 12345

# log file
log ${log_file}


#-----------------------------------------------
# S I M U L A T I O N      S E T U P
#-----------------------------------------------

# create atoms
print "N_beads = ${N_beads}  N_chains = ${N_chains} random_seed = ${random_seed}"
# create_atoms 0 random ${N_chains} 12345 box mol polymer ${random_seed}
read_restart ${restart_file} # read in the final configuration from the equilibration run

# neighbor list settings
neighbor 0.5 bin #TODO return this to 0.3 if things break
neigh_modify every 1 delay 0 check yes
comm_modify cutoff 3.5

# interatomic potentials (non-bonded)
pair_style hybrid/overlay lj/cut 1.12246205 gauss 2.0 # cutoff for both at 2.0
pair_coeff 1 1 lj/cut 1.0 1.0  # WCA between backbone beads
pair_coeff 1 2 lj/cut 0.0 1.0  # WCA between backbone and amine patches
pair_coeff 2 2 lj/cut 0.0 1.0 # no WCA between amine patches
pair_modify shift yes # shift to zero at cutoff
pair_coeff 2 2 gauss ${patch_gauss_A_strength} ${patch_gauss_B_width} 2.0 # Gaussian attraction between amine patches

fix langevin_int all langevin 1.0 1.0 200.0 ${random_seed} # Langevin thermostat, temp 1.0, damping parameter $(200.0*dt), random seed 12345
fix nve_int all nve # switch to NVE ensemble

# save mean squared displacement data (optional)
if "${output_msd} == 1" then &
    "print 'Saving MSD data to ${output_msd_file}'" &
    "compute MSD all msd" &
    "fix msd_avg all ave/time 10 1 10 c_MSD[4] file ${output_msd_file} mode scalar"

# save amine positions for bond analysis (optional)
if "${output_amine} == 1" then &
    "print 'Saving amine positions to ${output_amine_file}'" &
    "dump aminepos amine custom 100000 ${output_amine_file} id type x y z"

# save trajectory of all particles (optional)
if "${output_traj} == 1" then &
    "print 'Saving trajectory to ${output_traj_file}'" &
    "dump traj all atom 10 ${output_traj_file}"

# save p_xy data for modulus calculation
if "${output_press} == 1" then &
    "print 'Saving pressure data to ${output_press_file}'" &
    "fix 2 all ave/time 1 1 10 c_thermo_press[0] c_thermo_press[1] c_thermo_press[2] c_thermo_press[3] c_thermo_press[4] c_thermo_press[5] c_thermo_press[6] file ${output_press_file}"

variable px_y equal c_thermo_press[1] - c_thermo_press[2]
variable px_z equal c_thermo_press[1] - c_thermo_press[3]
variable py_z equal c_thermo_press[2] - c_thermo_press[3]

# compute average end to end length of a chain
variable dxx equal x[1] - x[${chain_length}]
variable dyy equal y[1] - y[${chain_length}]
variable dzz equal z[1] - z[${chain_length}]
variable re2 equal v_dxx*v_dxx + v_dyy*v_dyy + v_dzz*v_dzz
variable re equal sqrt(v_re2)
fix endtoend all ave/time 100 100 10000 v_re file logs/endtoend_short.dat

# compute all_atoms all count/type atom
variable natoms equal atoms
print "Total number of atoms is ${natoms}"
if "${output_press_autocorr} == 1" then &
    "print 'Saving pressure autocorrelation data to ${output_press_autocorr_file}' " &
    "fix long_corr all ave/correlate/long 1 100000 v_px_y v_px_z v_py_z c_thermo_press[4] c_thermo_press[5] c_thermo_press[6] type auto file ${output_press_autocorr_file} overwrite title1 title2 ncorr 40 nlen 16 ncount 2" &
        # "v_px_y v_px_z v_py_z c_thermo_press[4] c_thermo_press[5] c_thermo_press[6]" &
        # "type auto & " &
        # "file ${output_press_autocorr_file} &" &
        # "overwrite &" &
        # "title1 "# v_px_y v_px_z v_py_z c_thermo_press[4] c_thermo_press[5] c_thermo_press[6]" & " &
        # "title2 "# total number of atoms: ${natoms}" &" &
        # "ncorr 70 &" &
        # "nlen 16 &" &
        # "ncount 2" &

#-----------------------------------------------
# P R O D U C T I O N     R U N 
#-----------------------------------------------

# experiment run 
compute temp_com all temp/com
timestep 0.005
thermo_style custom step temp epair emol etotal press pxy c_temp_com
thermo 100
dump prod all custom 1000000 ${output_traj_file} id type mol x y z ix iy iz
# run 50000
run 500000000
undump prod

variable density equal ${natoms} / (${wall_size} * ${wall_size} * ${wall_size})
print "Final density is ${density}"

print "Ending in.polymers (long)"
